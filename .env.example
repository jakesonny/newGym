# 서버 설정
PORT=3001
NODE_ENV=production
REQUEST_TIMEOUT=30000

# 데이터베이스 설정 (Render 권장: DATABASE_URL 단일 사용)
# Render PostgreSQL > Connections > Internal Database URL 값을 그대로 붙여넣기
# 예시 포맷: postgresql://username:password@hostname:5432/database
DATABASE_URL=postgresql://<username>:<password>@<hostname>:5432/<database>
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SCHEMA=newgym

# 아래 개별 DB_* 값들은 DATABASE_URL이 없을 때만 사용됨 (선택)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=gym_membership_db

# 보안 설정 (JWT)
JWT_SECRET=your-very-secret-key-change-me
JWT_EXPIRES_IN=7d

# CORS 설정 (쉼표로 구분하여 여러 URL 허용 가능)
FRONTEND_URL=http://localhost:3000,https://new-gym-front.vercel.app

# 외부 서비스 연동 (카카오 로그인 등)
# KAKAO_CLIENT_ID=
# KAKAO_CALLBACK_URL=
